<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Chat </title>
</head>
<body>
    <p>Edit your Chat : <b><%= Chat._id %></b> <p>
    <p>This chat was sent form  <b><%= Chat.from %> </b>to<b><%= Chat.to%></b></p>
    <form method="POST" action="/chats/<%= Chat._id%>?_method=PUT">
       <textarea name="msg" rows="10" cols="10"><%= Chat.msg %> </textarea>
       <button>Edit</button>
    </form>
</body>
</html>